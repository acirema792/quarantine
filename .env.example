# Vultr Serverless Inference (OpenAI-compatible). Required for the analyst + report agents.
VULTR_INFERENCE_API_KEY=
VULTR_INFERENCE_BASE_URL=https://api.vultrinference.com/v1
# Preference list; the first model present in GET /v1/models is used.
VULTR_MODEL=kimi-k2-instruct,kimi-k2.6,glm-5.3,deepseek-v4.1-flash,qwen3.8-flash-next

# Sandbox
SANDBOX_RUNTIME=auto          # auto -> runsc (gVisor) when installed, else runc
SANDBOX_MEMORY=768m
SANDBOX_CPUS=1
SANDBOX_PIDS=256
SANDBOX_TIMEOUT=150           # hard wall clock per detonation (seconds)
SANDBOX_SUBNET_POOL=10.250    # host firewall drops 10.250.0.0/16 -> VM
REGISTRY_ALLOW=registry.npmjs.org,pypi.org,files.pythonhosted.org

# App
DATA_DIR=./data
RECEIPT_KEY=                  # HMAC key for receipts (auto-generated if empty)
RATE_LIMIT_PER_HOUR=40
MAX_CONCURRENT_RUNS=2
ADMIN_TOKEN=                  # if set, approve/block requires X-Admin-Token
