#!/usr/bin/env bash
# qnpm — npm install, but every new package clears Quarantine customs first.
# Put it on PATH (or alias npm=qnpm) for developers, CI jobs and coding agents.
#
#   QUARANTINE_URL=https://your-quarantine.example qnpm install left-pad@1.3.0
#
# allow   -> runs the real npm install
# block   -> refuses
# unknown -> submits a scan, waits for the verdict, installs only if CLEAN
set -euo pipefail
Q="${QUARANTINE_URL:?set QUARANTINE_URL}"
case "${1:-}" in
  install|i|add|ci) ;;
  *) exec npm "$@" ;;
esac
cmd="$1"; shift
pkgs=0; for a in "$@"; do case "$a" in -*) ;; *) pkgs=$((pkgs+1));; esac; done
if [ "$cmd" = "ci" ] || [ "$pkgs" = 0 ]; then
  # Installing from a lockfile: every pinned package must already be approved.
  [ -f package-lock.json ] || { echo "quarantine: no package-lock.json; run qnpm install <pkg>" >&2; exit 1; }
  missing=$(python3 - "$Q" <<'PY'
import json, sys, urllib.parse, urllib.request
q = sys.argv[1]
lock = json.load(open("package-lock.json"))
bad = []
for path, meta in (lock.get("packages") or {}).items():
    if not path or not meta.get("version"):
        continue
    name = path.split("node_modules/")[-1]
    url = f"{q}/api/gate?ecosystem=npm&name={urllib.parse.quote(name)}&version={urllib.parse.quote(meta['version'])}"
    d = json.load(urllib.request.urlopen(url, timeout=20))
    if d.get("decision") != "allow" or (d.get("integrity") and meta.get("integrity") and d["integrity"] != meta["integrity"]):
        bad.append(f"{name}@{meta['version']} ({d.get('decision')})")
print("\n".join(bad))
PY
)
  if [ -n "$missing" ]; then echo "quarantine: not cleared:" >&2; echo "$missing" | sed 's/^/  /' >&2; exit 1; fi
  exec npm "$cmd" "$@"
fi
json() { python3 -c "import json,sys; d=json.load(sys.stdin); print($1)"; }
for spec in "$@"; do
  case "$spec" in -*) continue;; esac
  name="${spec%@*}"
  [ -z "$name" ] && name="$spec"   # scoped name without a version: @scope/pkg
  # Decisions are per exact version: resolve ranges and dist-tags the way npm would.
  ver=$(npm view "$spec" version --json 2>/dev/null | python3 -c "import json,sys; v=json.load(sys.stdin); print(v[-1] if isinstance(v,list) else v)")
  [ -n "$ver" ] || { echo "quarantine: cannot resolve $spec" >&2; exit 1; }
  spec="$name@$ver"
  gate=$(curl -fsS "$Q/api/gate?ecosystem=npm&name=$(python3 -c "import urllib.parse,sys;print(urllib.parse.quote(sys.argv[1]))" "$name")&version=$ver")
  decision=$(echo "$gate" | json 'd["decision"]')
  if [ "$decision" = "block" ]; then echo "quarantine: $spec is BLOCKED by policy" >&2; exit 1; fi
  if [ "$decision" = "allow" ]; then
    # The approval is for specific bytes: make sure the registry still serves those bytes.
    want=$(echo "$gate" | json 'd.get("integrity","")')
    have=$(npm view "$spec" dist.integrity 2>/dev/null || true)
    if [ -n "$want" ] && [ "$want" != "$have" ]; then echo "quarantine: $spec integrity changed since approval" >&2; exit 1; fi
  fi
  if [ "$decision" = "unknown" ]; then
    echo "quarantine: $spec has not cleared customs — detonating it now…" >&2
    id=$(curl -fsS -X POST "$Q/api/runs" -H 'content-type: application/json' -d "{\"spec\":\"npm:$spec\"}" | json 'd["id"]')
    while :; do
      r=$(curl -fsS "$Q/api/runs/$id"); st=$(echo "$r" | json 'd["status"]')
      [ "$st" = "done" ] || [ "$st" = "error" ] && break; sleep 3
    done
    verdict=$(echo "$r" | json 'd.get("verdict")')
    echo "quarantine: $spec -> $verdict ($Q/#/run/$id)" >&2
    [ "$verdict" = "CLEAN" ] || { echo "quarantine: refusing to install $spec" >&2; exit 1; }
  fi
done
exec npm install "$@"
